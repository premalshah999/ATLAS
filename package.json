{
  "name": "atlas-monorepo",
  "private": true,
  "version": "0.1.0",
  "description": "ATLAS: local-first mission control for autonomous software engineering.",
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22.19.0"
  },
  "scripts": {
    "dev": "pnpm --filter @atlas/desktop dev",
    "build": "pnpm --filter @atlas/desktop build",
    "typecheck": "pnpm -r --workspace-concurrency=1 typecheck && tsc -p tsconfig.tests.json",
    "lint": "node scripts/check-deps.mjs && eslint .",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "pnpm build && playwright test -c tests/e2e-electron/playwright.config.ts",
    "package": "pnpm --filter @atlas/desktop package",
    "doctor": "node scripts/doctor.mjs",
    "pi:version": "node scripts/pi-version.mjs",
    "seed:sample": "node scripts/seed-sample.mjs",
    "screenshots": "pnpm build && playwright test -c tests/e2e-electron/screenshots.config.ts",
    "eval": "vitest run --project eval",
    "metrics": "pnpm build && playwright test -c tests/e2e-electron/metrics.config.ts"
  },
  "devDependencies": {
    "@atlas/browser": "workspace:*",
    "@atlas/contracts": "workspace:*",
    "@atlas/deploy": "workspace:*",
    "@atlas/desktop-control": "workspace:*",
    "@atlas/orchestrator": "workspace:*",
    "@atlas/policy": "workspace:*",
    "@atlas/runtime-fake": "workspace:*",
    "@atlas/runtime-pi": "workspace:*",
    "@atlas/storage": "workspace:*",
    "@atlas/terminal": "workspace:*",
    "@atlas/workspace": "workspace:*",
    "@eslint/js": "9.17.0",
    "@playwright/test": "1.56.1",
    "@types/node": "22.10.2",
    "eslint": "9.17.0",
    "typescript": "5.7.2",
    "typescript-eslint": "8.18.1",
    "vitest": "2.1.8"
  }
}
